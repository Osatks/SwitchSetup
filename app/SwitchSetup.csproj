<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SwitchSetup</AssemblyName>
    <RootNamespace>SwitchSetup</RootNamespace>
    <Version>2.4.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Product>SwitchSetup</Product>
    <Description>Set up your Switch SD card with the latest homebrew. Based on Homebrew SD Setup by noahc3.</Description>
    <Copyright>Original © noahc3; SwitchSetup contributors. MPL-2.0</Copyright>
    <!-- Single-file publish: dotnet publish -c Release -r win-x64 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- The UI and default catalog are embedded so the published app is one .exe -->
  <ItemGroup>
    <Content Remove="wwwroot\**;catalog.json" />
    <EmbeddedResource Include="wwwroot\**" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="catalog.json" LogicalName="catalog.json" />
  </ItemGroup>

</Project>
